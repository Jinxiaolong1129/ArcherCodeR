protocolVersion: 2
name: __NAME__
type: job
jobRetryCount: 0
jobType: others
prerequisites:
- type: dockerimage
  uri: registry-tmp.zhilicon.com:5000/jxldragon/archer2.0-env:latest
  name: docker_image0
taskRoles:
  taskrole:
    instances: 1
    completion:
      minFailedInstances: 1
    taskRetryCount: 0
    dockerImage: docker_image0
    extraContainerOptions:
      shmMB: 262144
    resourcePerInstance:
      gpu: 0
      cpu: 496
      memoryMB: 1433600
    commands:
    - '#!/bin/bash'
    - set -xeuo pipefail
    - '# ===== CPU SCORING: GROUP=__GROUP__ MODE=score BENCHES=__BENCHES__ (no GPU) ====='
    - env
    - nproc
    - curl -fsSL http://10.100.197.13/user_config/bootstrap.sh | bash -s -- --all
    - apt-get update && apt-get install -y iproute2 ceph-common kmod || true
    - mkdir -p /etc/ceph /mnt/cephfs
    - printf '%s\n' 'AQCypQpqu7a+NRAAcyxOgw5qocHjBvavcgjEmA==' > /etc/ceph/xiaolong.jin.secret
    - chmod 600 /etc/ceph/xiaolong.jin.secret
    - export CEPHFS_MONITORS="10.100.65.50,10.100.65.51,10.100.160.70:/"
    - if ! mountpoint -q /mnt/cephfs; then
    - mount -t ceph "$CEPHFS_MONITORS" /mnt/cephfs -o name=xiaolong.jin,secretfile=/etc/ceph/xiaolong.jin.secret
    - fi
    - timeout 60 bash -c 'until mountpoint -q /mnt/cephfs; do sleep 1; done'
    - test -d /mnt/cephfs/data/processing/xiaolong.jin && echo "cephfs OK"
    - export REPO_DIR=/mnt/cephfs/data/processing/xiaolong.jin/code/ArcherCodeR
    - cd "$REPO_DIR"
    - pip install --no-build-isolation -e . || true
    - export GROUP=__GROUP__
    - export MODE=score
    - export BENCHES="__BENCHES__"
    - export NUM_WORKERS=160
    - bash "$REPO_DIR/ltp/run_eval_group_ltp.sh"
    - echo "FINISHED cpu scoring __GROUP__"
defaults:
  virtualCluster: cpu2
extras:
  com.microsoft.pai.runtimeplugin:
  - plugin: ssh
    parameters:
      jobssh: true
  jobStatusChangeNotification:
    running: true
    succeeded: true
    failed: true
  hivedScheduler:
    taskRoles:
      taskrole:
        skuNum: 1
        skuType: storage
